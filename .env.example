# nrflo_server reads a .env file from the launch directory at startup and injects
# these into the process environment (without overriding vars already set).
# Copy to .env (gitignored) and fill in. See be/CLAUDE.md "## .env loading".

# Web research tools (deep-research / web_search / web_fetch)
SEARXNG_BASE_URL=     # required for web_search: self-hosted SearXNG with formats:[html,json]
# WEB_PROXY_URL=      # optional egress proxy: socks5://... or http://...; empty = direct

# OpenAI is NOT auto-authenticated (Anthropic agents use your Claude OAuth; OpenAI
# is API-key only). OPTIONAL: only enables deep-research's cross-provider verifier
# (verify_b). Without it the run still succeeds — the two Anthropic verifiers meet
# the L2 quorum:2. CODEX_API_KEY works as a fallback name.
# OPENAI_API_KEY=
